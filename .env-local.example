# crowfoot-core-api 로컬 시크릿 템플릿 — 복사해서 .env-local로 만들고 값을 채운다 (gitignore됨)
# 개발 DB 접속 정보는 07-sql/connection.md 참조
DB_USERNAME=
DB_PASSWORD=
# DB_URL — 기본값은 application-local.yml의 개발 서버(s3.java21.net:8000/crowfoot, schema crowfoot_core).
# 다른 DB를 쓸 때만 주석을 풀어 덮어쓴다:
# DB_URL=jdbc:postgresql://host:port/crowfoot?currentSchema=crowfoot_core
